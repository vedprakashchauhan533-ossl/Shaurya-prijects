{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing identity, contact phone number, profession and bio",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 20,
          "description": "Mobile number used for direct real-time messaging lookup"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000,
          "description": "Profile avatar image URL"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "User biography or startup pitch"
        },
        "profession": {
          "type": "string",
          "maxLength": 100,
          "description": "Profession e.g. Entrepreneur, Teen Founder, Business Executive, Wholesaler"
        },
        "companyOrMvpUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Link to project, product, or MVP"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "phoneNumber"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed post sharing ideas, feelings, business problems, MVP, or products with at most 2 photos",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "Firebase Auth UID of the author"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "authorPhoneNumber": {
          "type": "string",
          "maxLength": 20
        },
        "authorProfession": {
          "type": "string",
          "maxLength": 100
        },
        "authorPhotoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Post text sharing ideas, feelings, business problems, or MVP"
        },
        "category": {
          "type": "string",
          "enum": ["Idea", "MVP/Project", "Business Problem", "Product/Link", "Thought"],
          "description": "Post category tag"
        },
        "imageUrls": {
          "type": "array",
          "description": "Array of max 2 photo URLs"
        },
        "externalLink": {
          "type": "string",
          "maxLength": 1000,
          "description": "External product, MVP, or reference link"
        },
        "likesCount": {
          "type": "number",
          "description": "Number of upvotes / likes"
        },
        "commentsCount": {
          "type": "number",
          "description": "Number of comments"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["authorId", "authorName", "content", "category", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment under a post discussing the idea or business problem",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string"
        },
        "authorId": {
          "type": "string"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100
        },
        "authorProfession": {
          "type": "string",
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct conversation between users identified by mobile number or user ID",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "description": "List of participant user UIDs"
        },
        "participantPhones": {
          "type": "array",
          "description": "Mobile numbers of participants"
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 1000
        },
        "lastMessageSenderId": {
          "type": "string"
        },
        "lastMessageTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["participantIds", "participantPhones", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual chat message with seen / unseen receipt tracking",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "senderName": {
          "type": "string",
          "maxLength": 100
        },
        "senderPhone": {
          "type": "string",
          "maxLength": 20
        },
        "recipientPhone": {
          "type": "string",
          "maxLength": 20
        },
        "text": {
          "type": "string",
          "maxLength": 3000
        },
        "isAI": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["sent", "delivered", "seen"]
        },
        "seenAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["conversationId", "senderId", "text", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles searchable by mobile number or ID for networking"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public feed posts sharing ideas, MVP, business problems, feelings"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "PostComment",
      "description": "Comments on a post"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct chat sessions between two participants"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Individual messages in a direct chat with seen receipts"
    }
  }
}
